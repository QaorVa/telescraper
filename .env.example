# Telegram MTProto API Credentials (get from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Discord Webhook URL (Server/Channel Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Target Telegram Group Chat ID (e.g. -1001234567890), @username, or Group Name
# Leave blank to pick interactively from a menu on first run!
SOURCE_CHAT=
SOURCE_CHAT_NAME=

# Maximum media size in MB to upload to Discord (default: 10 MB for standard servers)
MAX_MEDIA_MB=10
